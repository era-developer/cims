# Node dependencies
node_modules/
**/node_modules/

# Environment variables
.env
backend/.env
frontend/.env

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# IDE / OS files
.DS_Store
Thumbs.db
desktop.ini
**/desktop.ini

# Cloud-sync temp folders
.tmp.driveupload/

# Python virtualenv
.venv/

# Claude Code local state
.claude/settings.local.json
.claude/*.lock

# Build output
frontend/build/

# SQLite databases and snapshots (runtime/test data, not source)
*.db
*.db-shm
*.db-wal
backend/data_v1_snapshot_for_migration_dryrun/
data_v1_snapshot_for_migration_dryrun/

# Backend runtime data
backend/data/*.xlsx
backend/data/*/
backend/data/*/*.xlsx

# Ignore npm package lock files only if generated in node_modules (keep root locks)
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# Local caches
**/.cache/
**/.parcel-cache/

# Coverage
coverage/

# Editor folders
.vscode/
.idea/

# Syncthing folder marker (copied over from D:\cims; KIMS is not a synced folder)
.stfolder/

